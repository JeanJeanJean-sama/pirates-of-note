{
  "manifest_version": 3,
  "name": "Pirates of note（非公式）",
  "short_name": "Pon",
  "description": "自分のnoteのアクセス数値を記録・分析する非公式ツール。毎日の推移、伸びた記事、未返信コメント、自分が書いたコメントを記録します。データはブラウザ内にだけ保存します。",
  "version": "0.1.1",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://note.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://note.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Pirates of note を開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}